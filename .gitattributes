# Keep Unix line endings for everything that runs in bash, Docker or Kubernetes,
# even when the repo is cloned on Windows (CRLF breaks "#!/usr/bin/env bash").
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.tf text eol=lf
*.tfvars text eol=lf
*.json text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.alloy text eol=lf
Dockerfile* text eol=lf
Makefile text eol=lf
